(()=>{
function install(){
  document.title='내말대로 | AI 요청 최적화 · 사진 복원 · 영상화';
  const brand=document.querySelector('.brand-new strong'); if(brand) brand.textContent='내말대로';
  const mh=document.querySelector('.mobile-sheet h3'); if(mh) mh.textContent='내말대로';
  const hero=document.querySelector('.home-hero-new h1'); if(hero) hero.innerHTML='AI가 멋대로 말고,<br><em>내말대로.</em>';
  const hp=document.querySelector('.home-hero-new p'); if(hp) hp.textContent='원하는 것만 편하게 말하세요. AI가 알아듣게 정리해드려요.';
  const note=document.querySelector('.home-note'); if(note) note.textContent='내말대로 · AI를 어렵게 쓰지 않는 방법';
  document.querySelectorAll('.real-example-section,.nmd-example-section').forEach(x=>x.remove());
  const old=document.querySelector('.restore-new'); if(old) old.style.display='none';
  const style=document.createElement('style');
  style.textContent=`
  .nmd-example-section{margin:25px 0 21px}
  .nmd-example-head{text-align:center;margin:0 auto 15px;max-width:660px}
  .nmd-example-pill{display:inline-block;padding:7px 11px;border:1px solid #ead9ae;border-radius:999px;background:#fff9e9;color:#9a7122;font-size:10px;font-weight:950}
  .nmd-example-head h2{margin:10px 0 6px;color:#071b3b;font-size:clamp(23px,3vw,31px);letter-spacing:-.8px}
  .nmd-example-head p{margin:0;color:#727b89;font-size:12px;line-height:1.65}
  .nmd-example-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .nmd-example-card{border:1px solid #ebe7dc;background:rgba(255,255,255,.9);border-radius:23px;padding:10px;text-align:left;cursor:pointer;box-shadow:0 10px 28px rgba(24,37,58,.05);overflow:hidden;transition:.16s}
  .nmd-example-card:hover{transform:translateY(-2px);box-shadow:0 15px 34px rgba(24,37,58,.08)}
  .nmd-example-card.wide{grid-column:1/-1}
  .nmd-example-card img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:16px;background:#f3efe6}
  .nmd-example-card.wide img{aspect-ratio:16/9}
  .nmd-example-copy{padding:12px 7px 7px}
  .nmd-example-copy b{display:block;color:#071b3b;font-size:16px;letter-spacing:-.3px}
  .nmd-example-copy span{display:block;color:#747c88;font-size:11px;line-height:1.55;margin-top:5px}
  .nmd-example-copy i{display:inline-block;margin-top:9px;font-style:normal;color:#a87821;font-size:10px;font-weight:900}
  @media(max-width:680px){.nmd-example-grid{grid-template-columns:1fr}.nmd-example-card.wide{grid-column:auto}.nmd-example-card.wide img,.nmd-example-card img{aspect-ratio:4/3}.nmd-example-head{text-align:left}.nmd-example-card{border-radius:19px}}
  `;
  document.head.appendChild(style);
  const anchor=document.querySelector('.home-benefits');
  if(!anchor)return;
  const sec=document.createElement('section');
  sec.className='nmd-example-section';
  sec.innerHTML=`
    <div class="nmd-example-head"><span class="nmd-example-pill">내말대로 사용 예시</span><h2>말한 것만 바꾸고, 맞는 건 그대로.</h2><p>화려하게 새로 만드는 것보다 실제로 쓸 수 있는 결과를 우선해요.</p></div>
    <div class="nmd-example-grid">
      <button class="nmd-example-card wide" data-go="photo"><img src="./.site/example-edit.svg?v=nmd4" alt="원본과 AI의 과도한 수정, 필요한 부분만 수정한 결과 비교"><div class="nmd-example-copy"><b>바꿀 건 이것만.</b><span>원본 전체를 다시 만들지 않고 요청한 부분만 정확하게.</span><i>부분 수정 도구 보기 →</i></div></button>
      <button class="nmd-example-card" data-go="create"><img src="./.site/example-poster.svg?v=nmd4" alt="홍보물에서 가격만 수정하는 예시"><div class="nmd-example-copy"><b>가격만 바꾸면 될 때.</b><span>디자인은 유지하고 필요한 정보만 수정하는 실무 예시.</span><i>요청문 만들기 →</i></div></button>
      <button class="nmd-example-card" data-go="restore"><img src="./.site/example-restore.svg?v=nmd4" alt="오래된 아기 사진 자연스러운 복원 전후 예시"><div class="nmd-example-copy"><b>기억은 그대로.</b><span>새로 그린 듯 바꾸지 않고 손상과 흐릿함을 자연스럽게 복원.</span><i>사진 복원 보기 →</i></div></button>
      <button class="nmd-example-card wide" data-go="animate"><img src="./.site/example-video.svg?v=nmd4" alt="복원 사진을 자연스러운 짧은 영상으로 만드는 예시"><div class="nmd-example-copy"><b>사진 한 장에서, 움직이는 추억까지.</b><span>복원한 이미지를 이어 짧고 자연스러운 영상으로 확장.</span><i>영상화 보기 →</i></div></button>
    </div>`;
  anchor.insertAdjacentElement('afterend',sec);
  sec.addEventListener('click',e=>{const b=e.target.closest('[data-go]');if(!b)return;const g=b.dataset.go;if(g==='photo')openModule('photo');else if(g==='create')openModule('create');else if(g==='restore')openPage('restore');else if(g==='animate')openPage('animate');});
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install);else install();
})();