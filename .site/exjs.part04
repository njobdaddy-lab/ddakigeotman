'};function install(){if(document.querySelector('.real-example-section'))return;const s=document.createElement('style');s.textContent=`.real-example-section{margin:18px 0 20px;background:rgba(255,255,255,.82);border:1px solid #ebe7dc;border-radius:24px;padding:18px;box-shadow:0 12px 30px rgba(24,37,58,.05)}.real-example-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:13px}.real-example-head span{font-size:10px;font-weight:950;color:#ba821e}.real-example-head h2{margin:4px 0 0;color:#071b3b;font-size:22px;letter-spacing:-.6px}.real-example-head p{margin:0;color:#7a8290;font-size:10px}.real-example-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.real-example-card{border:1px solid #ece7dd;background:#fff;border-radius:17px;padding:9px;cursor:pointer;text-align:left;overflow:hidden}.real-example-card img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px;background:#f2eee6}.real-example-card strong{display:block;color:#071b3b;font-size:12px;margin:9px 3px 3px}.real-example-card small{display:block;color:#7a8290;font-size:9px;line-height:1.45;margin:0 3px 3px}.restore-real-image{display:block;width:100%;height:100%;min-height:260px;object-fit:cover;border-radius:21px}.restore-visual.real-photo{display:block;background:#eee8dc}@media(max-width:820px){.real-example-grid{grid-template-columns:1fr 1fr}}@media(max-width:680px){.real-example-section{padding:13px;border-radius:20px}.real-example-head{align-items:flex-start;flex-direction:column}.real-example-head h2{font-size:19px}.restore-real-image{min-height:210px}}`;document.head.appendChild(s);const b=document.querySelector('.home-benefits');if(b){const sec=document.createElement('section');sec.className='real-example-section';sec.innerHTML=`<div class="real-example-head"><div><span>실제 작업 예시</span><h2>딱 필요한 작업이 이렇게 달라져요</h2></div><p>무료 도구부터 복원·업스케일·영상화까지</p></div><div class="real-example-grid"><button class="real-example-card" data-go="edit"><img src="${IMG.edit}"><strong>부분 수정</strong><small>선택한 곳만 바꾸고 나머지는 유지</small></button><button class="real-example-card" data-go="restore"><img src="${IMG.restore}"><strong>사진 복원</strong><small>손상·바램을 정리해 자연스럽게 복원</small></button><button class="real-example-card" data-go="upscale"><img src="${IMG.upscale}"><strong>업스케일</strong><small>작은 사진의 디테일과 선명도 개선</small></button><button class="real-example-card" data-go="video"><img src="${IMG.video}"><strong>사진 영상화</strong><small>복원한 사진에 자연스러운 움직임 추가</small></button></div>`;b.insertAdjacentElement('afterend',sec);sec.addEventListener('click',e=>{const x=e.target.closest('[data-go]');if(!x)return;const g=x.dataset.go;if(g==='edit'&&window.openModule)openModule('photo');else if(g==='restore'&&window.openPage)openPage('restore');else if(g==='upscale'&&window.openPage)openPage('upscale');else if(g==='video'&&window.openPage)openPage('animate')})}const rv=document.querySelector('.restore-visual');if(rv){rv.classList.add('real-photo');rv.innerHTML=`<img class="restore-real-image" src="${IMG.restore}" alt="가족사진 복원 전후 비교 예시">`;}}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install);else install();})();